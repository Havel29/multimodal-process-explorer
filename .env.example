# Optional: copy to .env only to change the configuration. Without it, the
# explorer uses the open X-ray example (config/xray_pathways.toml).
# For the CDSL data (credentialed PhysioNet access):
# EXPLORER_CONFIG=config/cdsl_covid.toml
# With an NVIDIA GPU, include the GPU file in every docker compose command:
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml
